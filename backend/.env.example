# Groq LLM — script generation
GROQ_API_KEY=your_groq_api_key

# Image generation (use deAPI OR HuggingFace — deAPI recommended, free $5 at deapi.ai)
DEAPI_API_KEY=your_deapi_key
DEAPI_IMAGE_MODEL=Flux1schnell
IMAGE_PROVIDER=auto

# HuggingFace — needs token with "Inference Providers" permission
HUGGINGFACE_API_KEY=your_huggingface_token
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Edge TTS voice (free Microsoft voices)
EDGE_TTS_VOICE=en-US-AriaNeural

# YouTube Data API (for CI / automation use refresh token)
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# Optional: local OAuth files instead of env vars above
# YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
# YOUTUBE_TOKEN_FILE=youtube_token.json

# Pipeline options
OUTPUT_DIR=output
TOPIC=
UPLOAD_TO_YOUTUBE=true
CLEANUP_OUTPUT_AFTER_UPLOAD=true
